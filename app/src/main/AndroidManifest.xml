<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Needed for the WebView AEC's getUserMedia({echoCancellation:true}) to select a
         communication audio device (Chromium's own audio_manager_android.cc requires this). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Lets WebViewAecHost add its overlay WebView via WindowManager.addView(TYPE_APPLICATION_OVERLAY)
         from HarnessService with no Activity ever in the foreground. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Set alarms/timers via AlarmClock intents; required to use EXTRA_SKIP_UI (no clock-app UI). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Location for the ambient "live device state" (weather, "where am I"). Dedicated device. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Teya-owned countdown timers via AlarmManager. USE_EXACT_ALARM (auto-granted) suits an
         alarm/timer assistant; SCHEDULE_EXACT_ALARM is the fallback path. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Family calendar via the CalendarContract provider (read "what's on" + create events). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Household members live in ContactsContract (roster + call list); synced to Google Contacts
         when the device has an account. GET_ACCOUNTS lets us target the Google account for sync. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Teya">

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Teya">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Teya" />

        <!-- Admin: opens in-place on the wall (landscape default). A manual in-app toggle rotates
             to portrait for heavier text entry via setRequestedOrientation; configChanges keeps the
             editor state alive across that rotate instead of recreating the activity. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Teya" />

        <service
            android:name=".harness.HarnessService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone|phoneCall" />

        <service
            android:name=".telephony.TeyaInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

    </application>

</manifest>
